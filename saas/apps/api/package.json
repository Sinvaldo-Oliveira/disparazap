    "admin:create": "node --env-file-if-exists=../../.env --conditions=source src/cli/create-super-admin.ts"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.15",
    "@disparazap/contracts": "0.1.0",
    "@disparazap/db": "0.1.0",
    "@disparazap/shared": "0.1.0",
    "@fastify/cors": "^11.3.1",
    "@node-rs/argon2": "2.2.2",
    "better-auth": "1.7.15",
    "fastify": "^5.12.7",
    "qrcode": "^1.5.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.6"
  }
}
