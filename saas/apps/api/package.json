{
  "name": "@disparazap/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "API HTTP do DisparaZap (Fastify)",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --conditions=source --watch src/index.ts",
    "start": "node --env-file-if-exists=../../.env dist/index.js",
