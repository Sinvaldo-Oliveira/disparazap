# Ambiente de desenvolvimento local do SaaS DisparaZap — só valores padrão ou fictícios.
# Copie para saas/.env (não versionado). As credenciais do banco (bloco do Supabase, no fim)
# são preenchidas só no saas/.env, nunca neste arquivo.

NODE_ENV=development
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# API — escuta só nesta máquina por padrão
API_HOST=127.0.0.1
API_PORT=3100
# Origens com permissão CORS, separadas por vírgula (vazio = nenhuma; "*" é recusado).
# O painel em desenvolvimento usa o proxy do Vite (mesma origem) e não precisa de CORS.
API_CORS_ORIGINS=
API_SHUTDOWN_TIMEOUT_MS=10000
# Só atrás de um proxy reverso (ex.: Hostinger). false (padrão) | true (aceita o X-Forwarded-For só de endereços internos)
# | lista de IPs/CIDRs do proxy, separados por vírgula
API_TRUST_PROXY=false
# Pasta do painel compilado (apps/web/dist): a API passa a entregar o painel na mesma origem.
# Vazio em desenvolvimento (quem serve o painel é o Vite). O pacote da Hostinger preenche sozinho.
WEB_DIST_DIR=

# Worker — sem filas nesta fase; o intervalo só registra que o processo está vivo
WORKER_HEARTBEAT_MS=30000
WORKER_SHUTDOWN_TIMEOUT_MS=10000

# Painel — lido apenas pelo servidor de desenvolvimento do Vite (nunca chega ao navegador)
WEB_API_PROXY_TARGET=http://127.0.0.1:3100

# ─────────────────────────────────────────────────────────────────────────────
# Banco de dados — Supabase Cloud (projeto exclusivo "disparazap")
# A API lê DATABASE_URL, DATABASE_CA_FILE e DATABASE_POOL_MAX. Com DATABASE_URL vazio, ela usa o
# banco embutido de desenvolvimento (PGlite, em saas/.data/), que não serve para produção.
# Guia: saas/docs/SUPABASE_CONFIGURACAO.md (seções 2, 3 e 6).
#
# Regras:
# - Preencha só no saas/.env. Nunca neste arquivo, no chat, em e-mail ou em print.
# - Não coloque aqui a senha do papel "postgres" (fica só no gerenciador de senhas).
# - Não coloque chaves da API do Supabase (publishable, secret, anon, service_role):
#   a arquitetura planejada não usa essas chaves.
# - Senhas dos papéis: só letras e números, com 32 caracteres ou mais (evita codificar a URL).
# - Os papéis dz_* só existem depois do SQL de preparação. Até lá, deixe estes campos vazios.
# - Nenhuma variável de banco pode começar com VITE_ ou WEB_ (seriam lidas pelo painel).
#
# Modelo — pooler compartilhado, modo sessão (IPv4; esta máquina não tem IPv6).
# Host, porta e [INDEX] vêm do botão "Connect" do painel, opção "Session pooler":
#   postgresql://[PAPEL].[PROJECT-REF]:[SENHA]@aws-[INDEX]-[REGION].pooler.supabase.com:5432/postgres?sslmode=verify-full
# ─────────────────────────────────────────────────────────────────────────────

# API: dados das empresas, sempre sob RLS (papel dz_app)
DATABASE_URL=
# API, módulo de plataforma do Super Admin (papel dz_platform)
DATABASE_PLATFORM_URL=
# Só para aplicar migrations, na máquina do operador (papel dz_migrator).
# Nunca configure esta variável no servidor da API ou do worker.
DATABASE_MIGRATION_URL=

# Projeto de TESTES (disparazap-test), nunca o projeto principal.
# Os testes se recusam a rodar se apontarem para o mesmo host de DATABASE_URL.
DATABASE_TEST_URL=
DATABASE_TEST_MIGRATION_URL=

# Caminho do certificado raiz do projeto (painel: Database → Settings → SSL),
# guardado FORA do repositório. Ex.: C:\caminho\fora\do\repositorio\supabase-ca.crt
DATABASE_CA_FILE=
# Conexões por processo (no plano Micro, o modo sessão permite 15 por papel)
DATABASE_POOL_MAX=10
# Banco embutido de desenvolvimento: pasta dos dados (vazio = saas/.data/pglite; "memory://" = só em memória)
DATABASE_EMBEDDED_DIR=

# Papel dz_auth (esquema identity) — previsto para a separação de papéis no Supabase; ainda não lido:
# DATABASE_AUTH_URL=

# ─────────────────────────────────────────────────────────────────────────────
# Autenticação (Better Auth)
# ─────────────────────────────────────────────────────────────────────────────
# Segredo que assina os cookies de sessão: 32 caracteres aleatórios ou mais, só no saas/.env.
# Gere com: node -e "console.log(require('crypto').randomBytes(36).toString('base64url'))"
# Vazio em desenvolvimento = segredo temporário (as sessões caem a cada reinício). Obrigatório em produção.
AUTH_SECRET=
# Endereço do painel como o navegador o vê (origem confiável). Em produção, https://
AUTH_BASE_URL=http://127.0.0.1:3000
# Outras origens confiáveis, separadas por vírgula (vazio = só AUTH_BASE_URL)
AUTH_TRUSTED_ORIGINS=
# Cadastro público de empresas pela tela "Criar conta" (true ou false)
AUTH_SIGNUP_ENABLED=true
# E-mail do Super-Admin: reservado (ninguém se cadastra com ele) e usado por `npm run admin:create`.
# A senha é digitada no terminal na hora. Nunca coloque senha aqui.
SUPER_ADMIN_EMAIL=

# ─────────────────────────────────────────────────────────────────────────────
# Cofre de credenciais (AES-256-GCM)
# ─────────────────────────────────────────────────────────────────────────────
# Chave-mestra que cifra as credenciais guardadas no banco (ex.: chave global da Evolution Go,
# informada pelo Super-Admin em Configurações). 32 bytes aleatórios em base64url, só no saas/.env.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# ATENÇÃO: se esta chave for perdida ou trocada, as credenciais já guardadas não abrem mais
# (será preciso informá-las de novo). Guarde uma cópia no gerenciador de senhas. Obrigatória em produção.
SECRETS_MASTER_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Inbox (WhatsApp pela Evolution Go) — desligada até a homologação
# ─────────────────────────────────────────────────────────────────────────────
# Receber os eventos da Evolution Go por WebSocket (uma conexão de saída com a chave global
# da integração configurada em Configurações). Deixe false até a homologação autorizada
# (saas/docs/HOMOLOGACAO_I0_EVOLUTION.md, seção 10). Nunca ligue apontando para um servidor real
# sem autorização do dono do produto.
INBOX_EVENTS_ENABLED=false
# Liberar o botão "Receber mensagens na Inbox" (Integrações → WhatsApp), que liga os eventos numa
# instância da empresa. Nada é ligado sozinho: cada instância é ligada pelo dono ou administrador.
INBOX_ACTIVATION_ENABLED=false
# Respostas humanas pelo Instagram na Inbox (pela Zernio, com a chave da empresa). Com true, a mensagem
# chega de verdade à pessoa. Exige a tabela app.inbox_social_sends (migração 0008). Padrão false.
INBOX_SOCIAL_SEND_ENABLED=false

# ─────────────────────────────────────────────────────────────────────────────
# Automações de redes pela Zernio (saas/docs/PLANO_MODULO_AUTOMACOES.md)
# ─────────────────────────────────────────────────────────────────────────────
# Criar, alterar, ativar e pausar automações na Zernio. Automações ativas enviam DMs reais sozinhas.
# Deixe false até a homologação autorizada (H1 a H3). Com false, a página só lista e mostra detalhes.
AUTOMATIONS_WRITE_ENABLED=false
