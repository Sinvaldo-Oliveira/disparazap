# Copie este arquivo para .env (não renomeie: o .env.example deve continuar existindo) e preencha.

# URL base do servidor Evolution Go (sem barra no final)
EVOLUTION_URL=https://seu-servidor-evolution.exemplo

# Chave API global do Evolution Go — fica só no servidor, nunca vai para o navegador
GLOBAL_API_KEY=sua-global-api-key

# Porta local do disparador
PORT=3000

# Opcional — endereço de escuta. Padrão: 127.0.0.1 (só este computador).
# 0.0.0.0 abre o disparador para outros aparelhos da rede SEM login. Só use em rede confiável.
# HOST=127.0.0.1

# Opcional — arquivo PEM de uma autoridade certificadora extra, se o Evolution usar certificado próprio.
# A verificação HTTPS continua obrigatória; isto só acrescenta uma autoridade confiável.
# EVOLUTION_CA_FILE=C:/caminho/para/ca-evolution.pem
